<html>
<body>

<div style='background-color: #222; color: #1D1D1D; max-width: 800px; padding: 20px; font-size: 12px; font-family: "Helvetica, Verdana, Arial, sans-serif"; text-shadow: white 0px 1px;'>

  <div style='margin-top: 20px; margin-bottom: 30px;'>
  <img src="https://www.diveboard.com/img/logo-alpha.png" alt="DiveBoard">
  </div>

  <div style=' background-color: #f9c03d; margin-bottom: 0; padding: 10px; font-size: 24px; font-weight: bolder; text-shadow: #FAF183 0px 1px;'><%= it("Confirm your email address", scope: ['password_reset', 'confirm_email']) %></div>
  <div style='background-color: #f4f4f4; margin-top: 0; padding: 30px 10px 10px 10px;'>
    <p style='margin: 0px 0 20px 0;'><%= it("Welcome to Diveboard. Please confirm this is your email address so you can publish posts and hear from us.", scope: ['password_reset', 'confirm_email']) %></p>
    <p style='margin: 20px 0 20px 0;'><%= it("Click here to confirm : %{link:Confirm my email address}.", scope: ['password_reset', 'confirm_email'], link: It.link(@confirm_url, style: "text-decoration: none; color: #FF6200;")) %></p>
    <p style='margin: 20px 0 20px 0;'><%= it("You can also copy/paste the following URL into your favorite browser : %{url}", scope: ['password_reset', 'confirm_email'], url: @confirm_url) %></p>
    <p style='margin: 20px 0 0px 0;'><%= it("You can log dives straight away. If you did not create this account you can ignore this message.", scope: ['password_reset', 'confirm_email']) %></p>

    <p style='margin: 30px 0 5px 0;'><%= it("Happy Diving !", scope: ['password_reset', 'confirm_email']) %></p>
    <p style='margin: 5px 0 5px 0;'><%= it("The Diveboard team", scope: ['password_reset', 'confirm_email']) %></p>
    <p style='margin: 5px 0 0px 0;'><a href='https://www.diveboard.com'>https://www.diveboard.com</a></p>

  </div>

</div>
</body>
</html>
